{
  "info": {
    "name": "SkillSpan — Mentor / Student Communication API",
    "description": "نظام التواصل بين المرشد والطالب (API v1).\n\n**طريقة الاستخدام:**\n1. افتح فولدر `0 · Setup` وشغّل `تسجيل الدخول (خزّن التوكن)` — التوكن بيتخزن أوتوماتيك في متغير `{{token}}`.\n2. شغّل `GET /mentor/students` — أول student id بيتخزن أوتوماتيك في `{{student_id}}`.\n3. بعد كده امشِ بالترتيب من فوق لتحت، وكل `Send` هيشتغل من غير ما تعدّل حاجة.\n\n**ملاحظات مهمة:**\n- راوتس `/mentor/*` لازم التوكن بتاعها يكون ليوزر عنده ProfessionalProfile بنوع `mentor` وحالة `verified`، وإلا هيرجع 403 `MENTOR_ONLY`.\n- لو `GET /mentor/students` رجع فاضي، معناها مفيش طلاب ظاهرين للمرشد ده (كلهم visibility=private ومفيش connection) — استخدم student id من الداتابيز يدوي.\n- متغيرات الـ IDs (`{{connection_id}}`, `{{conversation_id}}`, `{{notification_id}}`) بتتخزن أوتوماتيك بعد كل إنشاء.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// ضمان وجود التوكن قبل أي طلب محمي",
          "const t = pm.collectionVariables.get('token');",
          "if (!t && !pm.request.url.toString().includes('/auth/login')) {",
          "    console.warn('⚠️ مفيش توكن — شغّل تسجيل الدخول الأول من فولدر 0 · Setup');",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://back-end-feature-authentication.test", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "email", "value": "mentor@test.com", "type": "string" },
    { "key": "password", "value": "password123", "type": "string" },
    { "key": "student_email", "value": "student@test.com", "type": "string" },
    { "key": "student_password", "value": "password123", "type": "string" },
    { "key": "student_id", "value": "2", "type": "string" },
    { "key": "project_id", "value": "1", "type": "string" },
    { "key": "connection_id", "value": "1", "type": "string" },
    { "key": "conversation_id", "value": "1", "type": "string" },
    { "key": "notification_id", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "0 · Setup",
      "description": "شغّل الطلبات دي الأول عشان تتخزن التوكن والـ student id.",
      "item": [
        {
          "name": "تسجيل الدخول (خزّن التوكن)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "if (j && j.data && j.data.token) {",
                  "    pm.collectionVariables.set('token', j.data.token);",
                  "    console.log('✅ التوكن اتخزن');",
                  "} else {",
                  "    console.warn('⚠️ مفيش توكن في الرد — راجع بيانات الدخول');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/login",
            "description": "عدّل `{{email}}` و `{{password}}` من متغيرات الـ Collection لو حسابك مختلف. التوكن بيتخزن أوتوماتيك."
          }
        },
        {
          "name": "قائمة الطلاب المسموحين (خزّن student_id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (pm.response.code === 403) {",
                  "    pm.test('403 — التوكن ده مش مرشد موثّق (MENTOR_ONLY)', () => {});",
                  "    console.warn('⚠️ التوكن مش بتاع مرشد verified — راوتس /mentor/* كلها هترجع 403. عدّل {{email}}/{{password}} لحساب مرشد.');",
                  "} else {",
                  "    pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "}",
                  "if (j && j.data && j.data.length) {",
                  "    pm.collectionVariables.set('student_id', j.data[0].id);",
                  "    console.log('✅ student_id = ' + j.data[0].id + ' (' + j.data[0].name + ')');",
                  "} else if (pm.response.code === 200) {",
                  "    console.warn('⚠️ مفيش طلاب ظاهرين — عدّل {{student_id}} يدوي');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/v1/mentor/students",
            "description": "بيرجع الطلاب المسموح للمرشد يشوفهم حسب قواعد الـ visibility. أول student id بيتخزن أوتوماتيك."
          }
        }
      ]
    },
    {
      "name": "1 · Mentor",
      "description": "راوتس المرشد — محتاجة توكن مرشد موثّق (verified mentor).",
      "item": [
        {
          "name": "ملخص طالب",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 أو 403 (حسب الـ visibility)', () => pm.expect([200, 403, 422]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/v1/mentor/students/{{student_id}}",
            "description": "ملخص بيانات الطالب. لو الطالب visibility=private ومفيش connection → 403 `STUDENT_NOT_VISIBLE`."
          }
        },
        {
          "name": "إنشاء Connection (بدون مشروع)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "if (j && j.data && j.data.id) {",
                  "    pm.collectionVariables.set('connection_id', j.data.id);",
                  "    console.log('✅ connection_id = ' + j.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_id\": {{student_id}},\n  \"initiated_by\": \"mentor\"\n}"
            },
            "url": "{{base_url}}/api/v1/mentor/connections",
            "description": "ينشئ connection بحالة pending. لو فيه connection موجود بالفعل → 422 `DUPLICATE_CONNECTION`. الـ connection_id بيتخزن أوتوماتيك."
          }
        },
        {
          "name": "إنشاء Connection (مع مشروع)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 أو 422', () => pm.expect([201, 422]).to.include(pm.response.code));",
                  "const j = pm.response.json();",
                  "if (j && j.data && j.data.id) {",
                  "    pm.collectionVariables.set('connection_id', j.data.id);",
                  "    console.log('✅ connection_id = ' + j.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_id\": {{student_id}},\n  \"project_id\": {{project_id}},\n  \"initiated_by\": \"mentor\"\n}"
            },
            "url": "{{base_url}}/api/v1/mentor/connections",
            "description": "عدّل `{{project_id}}` لمشروع موجود. بيفحص: availability (open/in_progress) + deadline + capacity + eligibility rules. الأخطاء: `PROJECT_NOT_AVAILABLE`, `PROJECT_DEADLINE_PASSED`, `PROJECT_CAPACITY_REACHED`, `PROJECT_ELIGIBILITY_FAILED`."
          }
        },
        {
          "name": "قائمة الـ Connections",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/v1/mentor/connections",
            "description": "كل connections المرشد (paginated)."
          }
        },
        {
          "name": "تفعيل Connection (status=active)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"active\"\n}"
            },
            "url": "{{base_url}}/api/v1/mentor/connections/{{connection_id}}",
            "description": "الـ status المسموح: `active` أو `disconnected` أو `archived`. لو disconnected ممكن تبعت `reason` كمان. الطالب بيوصله notification."
          }
        }
      ]
    },
