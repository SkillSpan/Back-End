APP_NAME=SkillSpan
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=skillspan
DB_USERNAME=root
DB_PASSWORD=

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# 'local' resolves to storage/app/private ON THE APP SERVER. On a container
# host (Render, Fly, ...) that filesystem has no persistent volume, so every
# deploy wipes runtime uploads — proof documents disappear while their
# database rows survive, and the panel is left linking to files that are gone.
# Point this at an S3-compatible bucket for anything that must persist.
FILESYSTEM_DISK=local

# Only needed when FILESYSTEM_DISK=s3.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Queue
# ---------------------------------------------------------------------------
# The intelligence recalculation listener (SkillDataChanged) is queued.
# 'sync' runs it inline — fine for local development. 'database' needs a
# worker (`php artisan queue:work`) or the recalculation never runs.
QUEUE_CONNECTION=database

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Third-party services
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_BASE_URL=
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# API authentication
# ---------------------------------------------------------------------------
# Sanctum personal access token lifetime, in minutes. Default: 20160 (14 days).
SANCTUM_TOKEN_EXPIRATION_MINUTES=20160

# ---------------------------------------------------------------------------
# Admin / internal endpoints
# ---------------------------------------------------------------------------
# Shared secret guarding the admin setup endpoint. Leave empty to disable it.
ADMIN_SETUP_SECRET=

# Shared secret for the internal baseline-items endpoint.
INTERNAL_BASELINE_ITEMS_SECRET=

# ---------------------------------------------------------------------------
# SkillSpan Data Science / FastAPI integration (US-INT-01)
# ---------------------------------------------------------------------------
DATA_SCIENCE_SERVICE_URL=http://127.0.0.1:8001
DATA_SCIENCE_SERVICE_TIMEOUT=10

# Service-to-service credential shared with the FastAPI intelligence
# service. REQUIRED on every intelligence call — a missing token fails
# locally (503 INTELLIGENCE_NOT_CONFIGURED) before any network call.
# Never a learner token; never exposed to the frontend.
DATA_SCIENCE_SERVICE_TOKEN=

# Versioned intelligence contract (defaults match the SRS paths).
DATA_SCIENCE_API_VERSION=v1
DATA_SCIENCE_SKILL_GAP_PATH=/api/v1/intelligence/skill-gap
DATA_SCIENCE_READINESS_PATH=/api/v1/intelligence/readiness
DATA_SCIENCE_ROADMAP_PATH=/api/v1/intelligence/roadmap

# Skill Match v1 — used by the legacy readiness flow
# (POST /api/v1/readiness/calculate). Independent of the intelligence/*
# paths above. Set this when Data Science moves the endpoint.
DATA_SCIENCE_SKILL_MATCH_PATH=/api/v1/skill-match

# Baseline assessment integration.
DATA_SCIENCE_BASELINE_PATH=api/v1/baseline
DATA_SCIENCE_BASELINE_VERSION=v1.0
DATA_SCIENCE_BASELINE_ENABLED=false

# Roadmap generation gate — enabled only when the FastAPI roadmap
# endpoint is deployed. Disabled means 503 INTELLIGENCE_NOT_CONFIGURED.
DATA_SCIENCE_ROADMAP_ENABLED=false

# Compatibility fallback when the service response carries no
# algorithm_version metadata.
DATA_SCIENCE_ALGORITHM_VERSION=skill-gap-v1

# ---------------------------------------------------------------------------
# US-REC-01 — Intelligent Assistant (§12.5 governance gate)
# ---------------------------------------------------------------------------
# FAILS CLOSED. The assistant stays disabled unless it is BOTH explicitly
# enabled AND a reference to the recorded approval is present. SRS v1.1 §12.5:
# "Sensitive data shall not be inserted into external AI services without
# explicit technical and governance approval."
ASSISTANT_ENABLED=false

# Free-text reference to the recorded §12.5 approval (ticket id, email
# thread, governance record). Must be non-empty before any learner context
# may leave the platform.
ASSISTANT_APPROVAL_REFERENCE=

# --- Assistant service transport (FastAPI chatbot) ---
# Laravel is the ONLY permitted caller. The service requires a bearer token on
# every /chat and allows no browser origins, so the frontend has no way in --
# all assistant traffic is Laravel-mediated.
#
# Default port 8010 matches the service's README (8000 is often already taken
# by another local service).
ASSISTANT_SERVICE_URL=http://127.0.0.1:8010
ASSISTANT_SERVICE_PATH=/chat

# Service-to-service credential, exactly as US-INT-01 §4 requires for the
# intelligence service. NEVER a learner Sanctum token and NEVER exposed to the
# client — a token shipped to a browser is public. Must match SERVICE_TOKEN in
# the chatbot service's environment.
ASSISTANT_SERVICE_TOKEN=

# Request timeout in seconds. ⚠️ The service fails over across three providers
# with a 30s cap EACH, so its worst case is ~90s. A ceiling below that can cut
# off a request the service would eventually have answered. Prefer lowering the
# service's own per-provider timeout (PROVIDER_TIMEOUT_SECONDS in its config.py)
# over raising this: 90 seconds is not an acceptable wait for an interactive
# endpoint either way.
ASSISTANT_SERVICE_TIMEOUT=60

# Frontend origins allowed to call this API from the browser (comma-separated, no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
