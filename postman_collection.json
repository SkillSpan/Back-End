{
  "info": {
    "name": "SkillBridge Auth API",
    "description": "مصادقة منصة SkillBridge",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "تسجيل فرد",
      "request": {
        "method": "POST",
        "header": [{"key": "Accept", "value": "application/json"}],
        "body": {
          "mode": "formdata",
          "formdata": [
            {"key": "user_type", "value": "individual"},
            {"key": "name", "value": "أحمد محمد"},
            {"key": "email", "value": "ahmed@test.com"},
            {"key": "phone", "value": "966501234567"},
            {"key": "password", "value": "password123"},
            {"key": "password_confirmation", "value": "password123"},
            {"key": "terms_accepted", "value": "true"},
            {"key": "privacy_accepted", "value": "true"},
            {"key": "education", "value": "هندسة برمجيات"},
            {"key": "specialization", "value": "تطوير الويب"},
            {"key": "career_status", "value": "طالب"}
          ]
        },
        "url": "{{base_url}}/api/auth/register"
      }
    },
    {
      "name": "تسجيل مؤسسة",
      "request": {
        "method": "POST",
        "header": [{"key": "Accept", "value": "application/json"}],
        "body": {
          "mode": "formdata",
          "formdata": [
            {"key": "user_type", "value": "organization"},
            {"key": "name", "value": "أحمد المدير"},
            {"key": "email", "value": "admin@company.com"},
            {"key": "password", "value": "password123"},
            {"key": "password_confirmation", "value": "password123"},
            {"key": "terms_accepted", "value": "true"},
            {"key": "privacy_accepted", "value": "true"},
            {"key": "organization_name", "value": "شركة التقنية"},
            {"key": "organization_type", "value": "company"},
            {"key": "organization_contact_email", "value": "info@company.com"},
            {"key": "organization_contact_phone", "value": "966501234567"},
            {"key": "organization_website", "value": "https://company.com"},
            {"key": "organization_description", "value": "شركة تقنية رائدة"},
            {"key": "proof_file", "type": "file", "src": []}
          ]
        },
        "url": "{{base_url}}/api/auth/register"
      }
    },
    {
      "name": "تأكيد الحساب",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Accept", "value": "application/json"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"ahmed@test.com\", \"otp\": \"123456\"}"
        },
        "url": "{{base_url}}/api/auth/verify"
      }
    },
    {
      "name": "إعادة إرسال OTP",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Accept", "value": "application/json"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"ahmed@test.com\"}"
        },
        "url": "{{base_url}}/api/auth/resend-otp"
      }
    },
    {
      "name": "تسجيل الدخول",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Accept", "value": "application/json"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"ahmed@test.com\", \"password\": \"password123\"}"
        },
        "url": "{{base_url}}/api/auth/login"
      }
    }
  ],
  "variable": [
    {"key": "base_url", "value": "http://localhost:8000", "type": "string"}
  ]
}
