            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"ahmed@test.com\", \"otp\": \"123456\"}"
        },
        "url": "{{base_url}}/api/auth/verify"
      }
    },
