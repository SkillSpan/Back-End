          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/career-roles",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "career-roles"
              ]
            },
            "description": "بدون توكن لازم يرجّع 401. أي حاجة تانية = ثغرة في الـ auth."
          }
        }
      ]
    },
    {
      "name": "02 · Career Roles",
      "item": [
        {
          "name": "List approved roles (paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "",
                  "const b = pm.response.json();",
                  "pm.test('envelope keeps success + message + data', () => {",
                  "  pm.expect(b.success).to.be.true;",
                  "  pm.expect(b).to.have.property('message');",
                  "  pm.expect(b.data).to.be.an('object');",
                  "});",
                  "",
                  "// الـ paginator جوّه data — الفرونت معتمد على الشكل ده، ممنوع يتغيّر",
                  "pm.test('paginator is nested inside data', () => {",
                  "  pm.expect(b.data).to.have.property('current_page');",
                  "  pm.expect(b.data).to.have.property('data').and.to.be.an('array');",
                  "  pm.expect(b.data).to.have.property('per_page');",
                  "});",
                  "",
                  "pm.test('per_page is the documented 15', () => pm.expect(b.data.per_page).to.eql(15));",
                  "",
                  "pm.test('only approved roles are exposed', () => {",
                  "  b.data.data.forEach(r => pm.expect(r.status).to.eql('approved'));",
                  "});",
                  "",
                  "pm.test('every row carries skills_count', () => {",
                  "  b.data.data.forEach(r => pm.expect(r).to.have.property('skills_count'));",
                  "});",
                  "",
                  "// نحفظ أول id عشان باقي الطلبات",
                  "if (b.data.data.length > 0) {",
                  "  pm.collectionVariables.set('career_role_id', b.data.data[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/career-roles",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "career-roles"
              ]
            },
            "description": "قائمة المسارات المهنية **المعتمدة فقط**، مع عدد المهارات لكل مسار.\n\nالترتيب `version desc, id desc` — الـ `id` كـ tie-breaker عشان الترتيب يبقى حتمي\nوالصفحات ما تتكرّرش."
          }
        },
        {
          "name": "Show one role",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('single role exposes id/title/version/status', () => {",
                  "  ['id', 'title', 'version', 'status'].forEach(k => pm.expect(d).to.have.property(k));",
                  "});",
                  "pm.test('role is approved', () => pm.expect(d.status).to.eql('approved'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/career-roles/{{career_role_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "career-roles",
                "{{career_role_id}}"
              ]
            },
            "description": "مسار واحد معتمد. مسار غير معتمد يرجّع **422 `CAREER_ROLE_NOT_APPROVED`**،\nومسار غير موجود يرجّع **404 `CAREER_ROLE_NOT_FOUND`** — التمييز مقصود."
          }
        },
        {
          "name": "Role skills (decision snapshot)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "",
                  "pm.test('payload carries career_role + skills + statistics + snapshot', () => {",
                  "  ['career_role', 'skills', 'statistics', 'snapshot'].forEach(k => pm.expect(d).to.have.property(k));",
                  "});",
                  "",
                  "pm.test('skills is a non-empty array', () => {",
                  "  pm.expect(d.skills).to.be.an('array').and.not.empty;",
                  "});",
                  "",
                  "pm.test('every skill carries level, weight, critical flag and prerequisites', () => {",
                  "  d.skills.forEach(s => {",
                  "    pm.expect(s).to.have.property('skill_id');",
                  "    pm.expect(s).to.have.property('required_level');",
                  "    pm.expect(s).to.have.property('importance_weight');",
                  "    pm.expect(s).to.have.property('is_critical');",
                  "    pm.expect(s).to.have.property('prerequisites');",
                  "  });",
                  "});",
                  "",
                  "pm.test('statistics.total_skills matches the skills array', () => {",
                  "  pm.expect(d.statistics.total_skills).to.eql(d.skills.length);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/career-roles/{{career_role_id}}/skills",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "career-roles",
                "{{career_role_id}}",
                "skills"
              ]
            },
            "description": "المهارات المطلوبة للمسار: المستوى المطلوب، الوزن، هل المهارة حرجة، والمتطلبات السابقة.\n\nمسار بدون مهارات يرجّع **422 `CAREER_ROLE_NO_SKILLS`**."
          }
        },
        {
          "name": "Unknown role → 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 404', () => pm.response.to.have.status(404));",
                  "pm.test('code is CAREER_ROLE_NOT_FOUND', () => {",
                  "  pm.expect(pm.response.json().code).to.eql('CAREER_ROLE_NOT_FOUND');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/career-roles/999999",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "career-roles",
                "999999"
              ]
            },
            "description": "مسار غير موجود → **404** مع كود واضح. استخدم الـ `code` في الواجهة، مش نص الرسالة."
          }
        }
      ]
    },
    {
      "name": "03 · Intelligence (الإصلاح)",
      "item": [
        {
          "name": "Latest decision — ROADMAP MUST BE RETURNED",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "",
                  "const b = pm.response.json();",
                  "const d = b.data || b;",
                  "",
                  "pm.test('decision exposes its identity + versions', () => {",
                  "  pm.expect(d).to.have.property('decision_id');",
                  "  pm.expect(d).to.have.property('role_id');",
                  "  pm.expect(d).to.have.property('role_version');",
                  "});",
                  "",
                  "// ===== الاختبار الحاسم: ده اللي كان بيفشل قبل الإصلاح ===== ",
                  "pm.test('roadmap is NOT null — the readiness flow no longer shadows it', () => {",
                  "  pm.expect(",
                  "    d.roadmap,",
                  "    'roadmap كان null رغم وجوده في قاعدة البيانات. لو الاختبار ده فشل، ' +",
                  "    'تأكد إن migration الـ flow اتشغّل وإن GET /intelligence/latest بيستخدم ' +",
                  "    'scopeIntelligenceFlow().'",
                  "  ).to.not.be.null;",
                  "});",
                  "",
                  "pm.test('roadmap carries its actions, not just its header row', () => {",
                  "  pm.expect(d.roadmap.actions).to.be.an('array').and.not.empty;",
                  "  d.roadmap.actions.forEach(a => {",
                  "    pm.expect(a).to.have.property('phase');",
                  "    pm.expect(a).to.have.property('title');",
                  "    pm.expect(a).to.have.property('order_index');",
                  "  });",
                  "});",
                  "",
                  "pm.test('roadmap status is a known value', () => {",
                  "  pm.expect(['active', 'superseded']).to.include(d.roadmap.status);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/intelligence/latest?career_role_id={{career_role_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "intelligence",
                "latest"
              ],
              "query": [
                {
                  "key": "career_role_id",
                  "value": "{{career_role_id}}"
                }
              ]
            },
            "description": "## ده الاختبار الحاسم\n\nقبل الإصلاح: تدفّقان بيكتبوا decision snapshots بحالة `succeeded` — الـ intelligence\n(فيه roadmap) والـ readiness القديم (مفيهوش). الـ endpoint كان بياخد **أحدث صف**\nبغض النظر عن التدفّق، فحساب readiness كان بيحجب الـ roadmap ويرجّع `roadmap: null`.\n\nبعد الإصلاح: القراءة مقيّدة بـ `scopeIntelligenceFlow()` — يعني `flow = 'intelligence'`\nأو `flow IS NULL` (الصفوف اللي قبل ما العمود يتضاف).\n\n**لو الاختبار ده فشل، رتّب الأسباب كده:**\n1. migration `2026_09_30_000002_add_flow_to_decision_snapshots_table` لسه ما اتشغّلش.\n2. الكود الجديد لسه ما اتنشرش على السيرفر اللي في `base_url`.\n3. مفيش roadmap متخزّن أصلًا للمتعلّم + المسار ده."
          }
        },
        {
          "name": "Latest decision — no career_role_id filter",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 or 404 when nothing was calculated yet', () => {",
                  "  pm.expect([200, 404]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 404) {",
                  "  pm.test('404 uses the DECISION_NOT_FOUND code', () => {",
                  "    pm.expect(pm.response.json().code).to.eql('DECISION_NOT_FOUND');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/intelligence/latest",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "intelligence",
                "latest"
              ]
            },
            "description": "بدون فلتر المسار. لو مفيش قرار ناجح خالص → **404 `DECISION_NOT_FOUND`**."
          }
        }
      ]
    },
