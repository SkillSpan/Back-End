            "url": "{{base_url}}/api/v1/applications",
            "description": "المتعلّم بيشوف طلباته بس — ما في طريق يشوف طلبات حدا تاني."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
