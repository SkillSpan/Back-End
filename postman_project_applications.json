                  "pm.test('فيه meta للـ pagination', () => pm.expect(m.total).to.be.a('number'));",
                  "pm.test('per_page الافتراضي = 15', () => pm.expect(m.per_page).to.eql(15));"
                ]
              }
            }
          ]
        },
