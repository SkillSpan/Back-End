    {
      "name": "2 · التكرار والـ idempotency",
      "description": "التقديم المتكرر بيرجّع 409. وإعادة نفس `idempotency_key` بترجّع نفس الطلب بـ 200 بدون صف جديد.",
      "item": [
        {
          "name": "1 · تقديم تاني لنفس المشروع → 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/projects/{{project_id}}/applications",
            "description": "مسموح بطلب واحد نشط فقط لكل مشروع.",
