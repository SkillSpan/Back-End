  "item": [
    {
      "name": "0 · Setup (شغّل ده الأول)",
      "description": "لازم تشغّل الفولدر ده الأول عشان تتخزن التوكنين والـ ids. بعدها شغّل الفولدرات بالترتيب.",
      "item": [
        {
          "name": "1 · تسجيل دخول المتعلّم (خزّن learner_token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/login",
            "description": "عدّل `{{learner_email}}` و `{{learner_password}}` من متغيرات الـ Collection. التوكن بيتخزن أوتوماتيك.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{learner_email}}\",\n  \"password\": \"{{learner_password}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "if (j.data.token !== undefined && j.data.token !== null) {",
                  "    pm.collectionVariables.set('learner_token', j.data.token);",
                  "    console.log('✅ توكن المتعلّم = ' + j.data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2 · تسجيل دخول صاحب المشروع (خزّن owner_token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/login",
            "description": "صاحب المشروع هو الي بيقرر على الطلبات. ممكن يكون نفس الحساب لو المشروع ملكك.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{owner_email}}\",\n  \"password\": \"{{owner_password}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "if (j.data.token !== undefined && j.data.token !== null) {",
                  "    pm.collectionVariables.set('owner_token', j.data.token);",
                  "    console.log('✅ توكن المالك = ' + j.data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "3 · تفاصيل المشروع (خزّن project_id و project_role_id)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/projects/{{project_id}}",
            "description": "بيرجّع `eligibility` و `capacity_state` و `available_project_roles` و `duration_days` للمتعلّم المسجّل. بيخزّن أول role متاح."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('فيه eligibility', () => pm.expect(pm.response.json().data.eligibility).to.not.be.undefined);",
                  "pm.test('فيه capacity_state', () => pm.expect(pm.response.json().data.capacity_state).to.not.be.undefined);",
                  "pm.test('فيه duration_days', () => pm.expect(pm.response.json().data.duration_days).to.be.a('number'));",
                  "const j = pm.response.json();",
                  "if (j.data.available_project_roles[0].id !== undefined && j.data.available_project_roles[0].id !== null) {",
                  "    pm.collectionVariables.set('project_role_id', j.data.available_project_roles[0].id);",
                  "    console.log('✅ project_role_id = ' + j.data.available_project_roles[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "4 · تصفّح المشاريع المتاحة",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/projects",
            "description": "الكتالوج. لاحط إن `eligibility` و `capacity_state` = `null` هنا عن قصد — مبيتحسبوش لكل مشروع في القائمة."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 · تقديم الطلب",
      "description": "المسار السليم. بيخزّن `application_id` وهو المستخدم بعد كده في فولدرات القرارات والسحب.",
      "item": [
        {
          "name": "1 · تقديم طلب (خزّن application_id)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/projects/{{project_id}}/applications",
            "description": "201 مع `status = submitted`. `active_key` و `submitted_at` بيتولّدوا تلقائي.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_role_id\": {{project_role_id}},\n  \"application_data\": {\n    \"motivation\": \"بدي أشتغل على مشروع حقيقي\",\n    \"hours_per_week\": 12\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('status = submitted', () => pm.expect(pm.response.json().data.status).to.eql('submitted'));",
                  "pm.test('is_active = true', () => pm.expect(pm.response.json().data.is_active).to.be.true);",
                  "const j = pm.response.json();",
                  "if (j.data.id !== undefined && j.data.id !== null) {",
                  "    pm.collectionVariables.set('application_id', j.data.id);",
                  "    console.log('✅ application_id = ' + j.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
